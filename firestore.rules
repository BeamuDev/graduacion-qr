// =============================================================
//  Reglas de seguridad Firestore — Generador de Entradas QR
//  Pega esto en: Consola Firebase → Firestore Database → Reglas
// =============================================================
//
//  Estructura multi-evento:
//    eventos/{eventoId}                       ← metadata + config PDF
//    eventos/{eventoId}/entradas/{codigo}     ← entradas de ese evento
//
//  Política:
//   - Cualquier usuario autenticado puede leer la lista de eventos
//     y las entradas (lo necesita el escáner para validar).
//   - Solo los admins pueden crear/editar/borrar eventos.
//   - Cualquier autenticado puede actualizar entradas (marcar usada).
//   - Solo admins pueden crear y borrar entradas.
//
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Emails con permisos de admin. Tiene que coincidir con
    // window.ADMIN_EMAILS en config.js.
    function esAdmin() {
      return request.auth != null
        && request.auth.token.email in [
             'admin@graduacion.es',
             'dptoextra@gmail.com'
           ];
    }

    // Eventos: cualquier autenticado lee, solo admin escribe
    match /eventos/{eventoId} {
      allow read:  if request.auth != null;
      allow write: if esAdmin();

      // Subcolección de entradas dentro de cada evento
      match /entradas/{codigo} {
        allow read, update: if request.auth != null;
        allow create, delete: if esAdmin();
      }
    }

    // Compatibilidad con datos antiguos (raíz)
    // Se mantiene leíble para que el botón de migración pueda copiarlos.
    match /entradas/{codigo} {
      allow read, update: if request.auth != null;
      allow create, delete: if esAdmin();
    }
    match /config/{docId} {
      allow read, write: if esAdmin();
    }

    // Bloquea cualquier otra colección por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
